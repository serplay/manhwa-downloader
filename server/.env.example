# Network
PORT=8000
BIND=0.0.0.0
CORS_ORIGINS=*

# Caching
CACHE_TTL_SECS=43200
STATUS_TTL_SECS=60

# Upstream requests
REQUEST_TIMEOUT_SECS=30
# Extra hostname suffixes the cover proxy may fetch from (comma separated)
PROXY_EXTRA_HOSTS=
# Bato rotates mirrors; override when the default is gated
BATO_BASE_URL=https://bato.si

# Downloads (Phase 2)
DOWNLOAD_DIR=./Downloads
MAX_CONCURRENT_DOWNLOADS=2
IMAGE_CONCURRENCY=6

# Politeness toward upstream sites, shared by every task, the cover proxy and
# the status probe: parallel requests per host, and minimum spacing between
# request starts to one host (jitter of up to half that is added).
HOST_CONCURRENCY=6
HOST_MIN_INTERVAL_MS=50

# Per-client-IP limit on starting downloads (token bucket). 0 disables it.
DOWNLOAD_RATE_PER_MIN=3
DOWNLOAD_RATE_BURST=6
# Reverse proxies in front of the server that append to X-Forwarded-For.
# 0 uses the socket peer. Behind a proxy, set this or every visitor shares one
# bucket (Vercel rewrite -> host load balancer is typically 2).
TRUSTED_PROXY_HOPS=0

# Logging: RUST_LOG filter, LOG_FORMAT=json for structured output
RUST_LOG=info

# Chrome-impersonating client for Cloudflare-fronted sources (Toonily).
IMPERSONATION_ENABLED=true
