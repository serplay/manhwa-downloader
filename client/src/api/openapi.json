{
  "openapi": "3.1.0",
  "info": {
    "title": "Manhwa Downloader API",
    "description": "Search manga sources, list chapters, and build downloadable archives.",
    "license": {
      "name": ""
    },
    "version": "0.2.0"
  },
  "paths": {
    "/chapters": {
      "get": {
        "tags": [
          "catalogue"
        ],
        "operationId": "chapters",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "description": "Source id or slug.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "query",
            "description": "Comic id as returned by search.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "description": "Chapter language for multi-language sources. Defaults to `en`.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChaptersResponse"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "502": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/download": {
      "post": {
        "tags": [
          "downloads"
        ],
        "operationId": "start_download",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DownloadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadAccepted"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "422": {
            "description": "Unsupported format on this server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "Too many downloads from this address; see Retry-After",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "501": {
            "description": "Source cannot download yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/download/cancel/{task_id}": {
      "post": {
        "tags": [
          "downloads"
        ],
        "operationId": "cancel",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cancelled"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Already finished",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/download/events/{task_id}": {
      "get": {
        "tags": [
          "downloads"
        ],
        "operationId": "events",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Server-Sent Events stream of TaskStatus objects; closes on a terminal state",
            "content": {
              "text/event-stream": {}
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/download/file/{task_id}": {
      "get": {
        "tags": [
          "downloads"
        ],
        "operationId": "file",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The archive",
            "content": {
              "application/octet-stream": {}
            }
          },
          "404": {
            "description": "Unknown task, failed task, or an archive whose retention window has closed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "Task still running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/download/status/{task_id}": {
      "get": {
        "tags": [
          "downloads"
        ],
        "operationId": "status",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskStatus"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "health",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/proxy-image": {
      "get": {
        "tags": [
          "images"
        ],
        "operationId": "proxy_image",
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "description": "Absolute image URL.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "referer",
            "in": "query",
            "description": "Referer the host expects.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The image bytes",
            "content": {
              "image/*": {}
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "502": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "get": {
        "tags": [
          "catalogue"
        ],
        "operationId": "search",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Title to search for.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "description": "Source id, slug, or `all`.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "description": "Preferred language code (only some sources honor it).",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "adult",
            "in": "query",
            "description": "Include adult titles and adult-oriented sources. Off by default.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Empty query or unknown source",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "501": {
            "description": "Source not ported yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "502": {
            "description": "Source failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/sources": {
      "get": {
        "tags": [
          "sources"
        ],
        "operationId": "list_sources",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SourceInfo"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tasks": {
      "get": {
        "tags": [
          "downloads"
        ],
        "operationId": "list_tasks",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TaskStatus"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Cancelled": {
        "type": "object",
        "required": [
          "status",
          "task_id"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "task_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "required": [
          "formats",
          "impersonation",
          "browser"
        ],
        "properties": {
          "browser": {
            "type": "boolean",
            "description": "Headless browser available for managed challenges (not built yet)."
          },
          "formats": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Output formats this build can produce. Filled in by the pipeline (Phase 2)."
          },
          "impersonation": {
            "type": "boolean",
            "description": "Chrome-impersonating client available for Cloudflare-fronted sources."
          }
        }
      },
      "Chapter": {
        "type": "object",
        "required": [
          "id",
          "number"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Source-specific identifier, opaque to the client."
          },
          "number": {
            "type": "string",
            "description": "Chapter label as the source shows it (`\"12\"`, `\"12.5\"`, `\"Extra\"`)."
          },
          "pages": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ChapterRef": {
        "type": "object",
        "required": [
          "id",
          "number"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "number": {
            "type": "string",
            "description": "Chapter label used for file names (\"12\", \"12.5\")."
          }
        }
      },
      "ChaptersResponse": {
        "type": "object",
        "required": [
          "source",
          "comic_id",
          "volumes",
          "total_chapters"
        ],
        "properties": {
          "comic_id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "total_chapters": {
            "type": "integer",
            "minimum": 0
          },
          "volumes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Volume"
            }
          }
        }
      },
      "Comic": {
        "type": "object",
        "required": [
          "id",
          "title",
          "languages"
        ],
        "properties": {
          "adult": {
            "type": "boolean",
            "description": "Flagged adult by the source (content rating or genre). Hidden unless the\nclient asks for adult content."
          },
          "cover": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Cover"
              }
            ]
          },
          "id": {
            "type": "string",
            "description": "Source-specific identifier, opaque to the client."
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Languages chapters are available in."
          },
          "title": {
            "type": "object",
            "description": "Localized titles keyed by language code. `en` when the source has one language.",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "Cover": {
        "type": "object",
        "description": "Where a cover image lives and which `Referer` (if any) the host expects.",
        "required": [
          "url"
        ],
        "properties": {
          "referer": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": "string"
          }
        }
      },
      "DownloadAccepted": {
        "type": "object",
        "required": [
          "task_id",
          "state",
          "status",
          "message",
          "status_url",
          "events_url",
          "file_url"
        ],
        "properties": {
          "events_url": {
            "type": "string"
          },
          "file_url": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/TaskState"
          },
          "status": {
            "type": "string",
            "description": "Legacy field the old client displayed."
          },
          "status_url": {
            "type": "string"
          },
          "task_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "DownloadRequest": {
        "type": "object",
        "required": [
          "source",
          "chapters"
        ],
        "properties": {
          "chapters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChapterRef"
            }
          },
          "comic_title": {
            "type": "string"
          },
          "format": {
            "$ref": "#/components/schemas/Format"
          },
          "lang": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string",
            "description": "Source id or slug."
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable code."
          },
          "message": {
            "type": "string"
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "FetchTier": {
        "type": "string",
        "description": "Which fetch strategy a source needs to get past its front door.",
        "enum": [
          "plain",
          "impersonate",
          "browser"
        ]
      },
      "Format": {
        "type": "string",
        "enum": [
          "pdf",
          "cbz",
          "cbr",
          "epub"
        ]
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "version",
          "uptime_s",
          "active_tasks",
          "capabilities",
          "sources",
          "upstream"
        ],
        "properties": {
          "active_tasks": {
            "type": "integer",
            "minimum": 0
          },
          "capabilities": {
            "$ref": "#/components/schemas/Capabilities"
          },
          "sources": {
            "$ref": "#/components/schemas/SourceCounts"
          },
          "status": {
            "type": "string"
          },
          "upstream": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HostStats"
            },
            "description": "Request, Cloudflare challenge and rate-limit counts per upstream host\nsince start, busiest first."
          },
          "uptime_s": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "version": {
            "type": "string"
          }
        }
      },
      "HostStats": {
        "type": "object",
        "description": "Snapshot of one host's counters since the process started.",
        "required": [
          "host",
          "requests",
          "challenged",
          "blocked",
          "rate_limited"
        ],
        "properties": {
          "blocked": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "challenged": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "host": {
            "type": "string"
          },
          "rate_limited": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "requests": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "required": [
          "results",
          "errors"
        ],
        "properties": {
          "errors": {
            "type": "object",
            "description": "Sources that failed, keyed by slug. A partial failure is still a 200.",
            "additionalProperties": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "results": {
            "type": "object",
            "description": "Results keyed by source slug.",
            "additionalProperties": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/Comic"
              }
            },
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "SourceCapabilities": {
        "type": "object",
        "required": [
          "search",
          "chapters",
          "download",
          "needs_browser"
        ],
        "properties": {
          "chapters": {
            "type": "boolean"
          },
          "download": {
            "type": "boolean"
          },
          "needs_browser": {
            "type": "boolean"
          },
          "search": {
            "type": "boolean"
          }
        }
      },
      "SourceCounts": {
        "type": "object",
        "required": [
          "implemented",
          "total"
        ],
        "properties": {
          "implemented": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "SourceInfo": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SourceMeta"
          },
          {
            "type": "object",
            "required": [
              "legacy_id",
              "status"
            ],
            "properties": {
              "legacy_id": {
                "type": "string",
                "description": "Legacy numeric identifier as a string, the form the old client sends."
              },
              "status": {
                "$ref": "#/components/schemas/SourceStatus"
              }
            }
          }
        ]
      },
      "SourceMeta": {
        "type": "object",
        "description": "Static description of a source. The numeric `id` is the legacy identifier the\nclient has always sent (`\"0\"` to `\"10\"`); `slug` is the new stable name.",
        "required": [
          "id",
          "slug",
          "name",
          "base_url",
          "speed",
          "languages",
          "tier",
          "capabilities",
          "adult"
        ],
        "properties": {
          "adult": {
            "type": "boolean",
            "description": "The site itself is adult-oriented; it is skipped entirely unless the\nclient asks for adult content."
          },
          "base_url": {
            "type": "string"
          },
          "capabilities": {
            "$ref": "#/components/schemas/SourceCapabilities"
          },
          "id": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "speed": {
            "$ref": "#/components/schemas/Speed"
          },
          "tier": {
            "$ref": "#/components/schemas/FetchTier"
          }
        }
      },
      "SourceStatus": {
        "type": "string",
        "enum": [
          "ok",
          "down",
          "blocked",
          "unknown"
        ]
      },
      "Speed": {
        "type": "string",
        "description": "How fast a source usually answers. Mirrors the tiers the old client hardcoded.",
        "enum": [
          "fastest",
          "fast",
          "slow"
        ]
      },
      "TaskState": {
        "type": "string",
        "enum": [
          "PENDING",
          "PROGRESS",
          "SUCCESS",
          "FAILURE",
          "CANCELLED"
        ]
      },
      "TaskStatus": {
        "type": "object",
        "description": "Snapshot of a task. Superset of the shape the old client polls.",
        "required": [
          "task_id",
          "state",
          "status",
          "progress",
          "chapter_current",
          "chapter_total",
          "total_chapters",
          "comic_title",
          "source",
          "format",
          "created_at"
        ],
        "properties": {
          "chapter_current": {
            "type": "integer",
            "minimum": 0
          },
          "chapter_total": {
            "type": "integer",
            "minimum": 0
